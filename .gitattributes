# Automatically normalize line endings for all text-based files
# https://git-scm.com/docs/gitattributes#_end_of_line_conversion
* text=auto

# For the following file types, normalize line endings to LF on check-in and
# prevent conversion to CRLF when they are checked out
*.ico         binary
*.png         binary
*.woff        binary
*.woff2       binary

.*            text eol=lf
*.css         text eol=lf
*.js          text eol=lf
*.jsx         text eol=lf
*.json        text eol=lf
*.lock        text eol=lf
*.md          text eol=lf
*.sql         text eol=lf
*.sum         text eol=lf
*.svg         text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.txt         text eol=lf
*.webmanifest text eol=lf
*.yml         text eol=lf
