{
  "name": "wren",
  "version": "0.1.0",
  "description": "Personal agent workspace",
  "license": "MIT",
  "author": "Andrew J. Torres <andrew.jonathan.torres@gmail.com> (https://andrewjtorr.es)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewjtorres/wren.git"
  },
  "type": "module",
  "scripts": {
    "clean": "concurrently --group --raw \"yarn:clean:*\"",
    "clean:artifact": "del .turbo \"*.log*\"",
    "clean:cache": "del node_modules/.cache",
    "format": "prettier --cache=node_modules/.cache/prettier/ --check --ignore-path=.prettierignore --log-level=warn \"**/*.@(json|md|yml)\"",
    "lint": "concurrently --group --raw \"yarn:lint:*\"",
    "lint:javascript": "eslint --cache --cache-location=node_modules/.cache/eslint/ \"**/*.[jt]s\"",
    "lint:typescript": "tsc --build",
    "postinstall": "husky",
    "refine": "concurrently --group --raw \"yarn:format\" \"yarn:lint\""
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^26.2.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "commitizen": "^4.3.2",
    "concurrently": "^10.0.5",
    "cz-conventional-changelog": "^3.3.0",
    "del-cli": "^7.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-formatjs": "^6.5.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.8",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^73.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.5.8",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-prettier": "^5.0.3",
    "turbo": "^2.10.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "dependenciesMeta": {
    "@ariga/atlas": {
      "built": true
    }
  },
  "engines": {
    "node": ">=24.19",
    "yarn": ">=4.18"
  },
  "private": true,
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "packages/*"
  ]
}
