{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NODE_ENV"],
      "inputs": ["src/**", "rolldown.config.ts", "!src/**/*.test.ts"]
    },
    "format": {
      "inputs": [
        "**/*.json",
        "**/*.md",
        "**/*.yml",
        ".prettierignore",
        "prettier.config.ts",
        "!.cursor",
        "!.turbo",
        "!.vscode",
        "!dist",
        "!node_modules",
        "!test-reports"
      ]
    },
    "lint:javascript": {
      "dependsOn": ["^build"],
      "inputs": [
        "config/typescript/**/*.json",
        "**/*.js",
        "**/*.ts",
        "tsconfig.json",
        "!.cursor",
        "!.turbo",
        "!.vscode",
        "!dist",
        "!node_modules",
        "!test-reports"
      ]
    },
    "lint:typescript": {
      "dependsOn": ["^build"],
      "inputs": [
        "config/typescript/**/*.json",
        "**/*.js",
        "**/*.ts",
        "tsconfig.json",
        "!.cursor",
        "!.turbo",
        "!.vscode",
        "!dist",
        "!node_modules",
        "!test-reports"
      ]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "env": ["CI"],
      "inputs": ["config/vitest/**", "src/**"]
    }
  }
}
