{
  "name": "@wren/common",
  "version": "0.1.0",
  "description": "Shared utilities and primitives",
  "license": "MIT",
  "author": "Andrew J. Torres <andrew.jonathan.torres@gmail.com> (https://andrewjtorr.es)",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    "./error": {
      "types": "./dist/error.d.ts",
      "default": "./dist/error.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./nanoid": {
      "types": "./dist/nanoid.d.ts",
      "default": "./dist/nanoid.js"
    },
    "./transformation": {
      "types": "./dist/transformation.d.ts",
      "default": "./dist/transformation.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "default": "./dist/validation.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewjtorres/wren.git",
    "directory": "packages/common"
  },
  "type": "module",
  "scripts": {
    "build": "rolldown --config=rolldown.config.ts",
    "clean": "concurrently --group --raw \"yarn:clean:*\"",
    "clean:artifact": "del .turbo dist test-reports \"*.log*\"",
    "clean:cache": "del node_modules/.cache",
    "format": "prettier --cache=node_modules/.cache/prettier/ --check --ignore-path=.prettierignore --log-level=warn \"**/*.@(json|md|yml)\"",
    "lint": "concurrently --group --raw \"yarn:lint:*\"",
    "lint:javascript": "eslint --cache --cache-location=node_modules/.cache/eslint/ \"**/*.[jt]s\"",
    "lint:typescript": "tsc --build",
    "refine": "concurrently --group --raw \"yarn:format\" \"yarn:lint\"",
    "test": "concurrently --group --raw \"yarn:test:*\"",
    "test:unit": "cross-env VITEST_ARTIFACT_ROOT_DIR=test-reports/unit vitest --config=config/vitest/vitest.config.ts --project=unit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^5.0.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "del-cli": "^7.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "lint-staged": "^17.5.1",
    "nanoid": "^6.0.1",
    "prettier": "^3.9.6",
    "rolldown": "^1.2.8",
    "rolldown-plugin-dts": "^0.28.5",
    "turbo": "^2.10.13",
    "type-fest": "^5.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "nanoid": "^6.0.0",
    "type-fest": "^5.6.0",
    "zod": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "nanoid": {
      "optional": true
    },
    "type-fest": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.21",
    "yarn": ">=4.18"
  },
  "private": true
}
