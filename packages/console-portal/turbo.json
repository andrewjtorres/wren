{
  "extends": ["//"],
  "tasks": {
    "build:portal": {
      "dependsOn": ["^build"],
      "env": ["NODE_ENV"],
      "inputs": [
        "public/**",
        "src/**",
        "react-router.config.ts",
        "vite.config.ts",
        "!src/**/snapshots",
        "!src/**/*.stories.ts",
        "!src/**/*.stories.tsx",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!src/**/stories.ts",
        "!src/**/stories.tsx",
        "!src/utils/decorator.tsx",
        "!src/utils/render.browser.tsx",
        "!src/utils/render.dom.tsx"
      ],
      "outputs": ["dist/client/**", "dist/server/**"]
    },
    "build:studio": {
      "dependsOn": ["@wren/common#build"],
      "env": ["NODE_ENV", "I18N_DEFAULT_LANGUAGE_TAG", "DEBUG"],
      "inputs": [
        ".storybook/**",
        "src/**",
        "vite.config.ts",
        "!src/**/snapshots",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!src/utils/render.browser.tsx",
        "!src/utils/render.dom.tsx",
        "!src/index.ts"
      ],
      "outputs": ["dist/studio/**"]
    },
    "format": {
      "inputs": [
        "**/*.json",
        "**/*.md",
        "**/*.webmanifest",
        "**/*.yml",
        ".prettierignore",
        "prettier.config.ts",
        "!.cursor",
        "!.react-router",
        "!.turbo",
        "!.vscode",
        "!dist",
        "!i18n",
        "!node_modules",
        "!test-reports",
        "!test-results",
        "!tmp"
      ]
    },
    "lint:css": {
      "inputs": [
        "**/*.css",
        ".stylelintignore",
        "prettier.config.ts",
        "stylelint.config.ts",
        "!.cursor",
        "!.react-router",
        "!.turbo",
        "!.vscode",
        "!dist",
        "!node_modules",
        "!public",
        "!test-reports",
        "!test-results",
        "!tmp"
      ]
    },
    "lint:i18n": {
      "inputs": ["i18n/**/*.json"]
    },
    "lint:javascript": {
      "dependsOn": ["^build"],
      "inputs": [
        "config/typescript/**/*.json",
        "**/*.js",
        "**/*.jsx",
        "**/*.ts",
        "**/*.tsx",
        "tsconfig.json",
        "!.cursor",
        "!.react-router",
        "!.turbo",
        "!.vscode",
        "!dist",
        "!node_modules",
        "!public",
        "!test-reports",
        "!test-results",
        "!tmp"
      ]
    },
    "lint:typescript": {
      "dependsOn": ["^build"],
      "inputs": [
        "config/typescript/**/*.json",
        "**/*.js",
        "**/*.jsx",
        "**/*.ts",
        "**/*.tsx",
        "tsconfig.json",
        "!.cursor",
        "!.react-router",
        "!.turbo",
        "!.vscode",
        "!dist",
        "!node_modules",
        "!public",
        "!test-reports",
        "!test-results",
        "!tmp"
      ]
    },
    "test:component": {
      "env": ["CI", "VITEST_ARTIFACT_ROOT_DIR"],
      "inputs": [
        "config/vitest/setup.component.ts",
        "config/vitest/vitest.config.ts",
        "src/**",
        "!src/**/snapshots",
        "!src/**/*.end-to-end.test.ts",
        "!src/**/*.integration.test.ts",
        "!src/**/*.stories.ts",
        "!src/**/*.stories.tsx",
        "!src/**/*.unit.test.ts",
        "!src/**/*.visual-regression.test.ts",
        "!src/**/*.visual-regression.test.tsx",
        "!src/**/end-to-end.test.ts",
        "!src/**/integration.test.ts",
        "!src/**/stories.ts",
        "!src/**/stories.tsx",
        "!src/**/unit.test.ts",
        "!src/**/visual-regression.test.ts",
        "!src/**/visual-regression.test.tsx",
        "!src/utils/decorator.tsx",
        "!src/utils/render.browser.tsx"
      ]
    },
    "test:end-to-end": {
      "env": ["LOCAL", "CI", "PLAYWRIGHT_HTML_REPORTER_HOST", "PORTAL_URL"],
      "inputs": [
        "config/playwright/playwright.config.ts",
        "public/**",
        "src/**",
        "react-router.config.ts",
        "vite.config.ts",
        "!src/**/snapshots",
        "!src/**/*.component.test.ts",
        "!src/**/*.component.test.tsx",
        "!src/**/*.integration.test.ts",
        "!src/**/*.stories.ts",
        "!src/**/*.stories.tsx",
        "!src/**/*.unit.test.ts",
        "!src/**/*.visual-regression.test.ts",
        "!src/**/*.visual-regression.test.tsx",
        "!src/**/component.test.ts",
        "!src/**/component.test.tsx",
        "!src/**/integration.test.ts",
        "!src/**/stories.ts",
        "!src/**/stories.tsx",
        "!src/**/unit.test.ts",
        "!src/**/visual-regression.test.ts",
        "!src/**/visual-regression.test.tsx",
        "!src/utils/decorator.tsx",
        "!src/utils/render.browser.tsx",
        "!src/utils/render.dom.tsx"
      ]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "env": ["CI", "VITEST_ARTIFACT_ROOT_DIR"],
      "inputs": [
        "config/vitest/vitest.config.ts",
        "src/**",
        "!src/**/snapshots",
        "!src/**/*.component.test.ts",
        "!src/**/*.component.test.tsx",
        "!src/**/*.end-to-end.test.ts",
        "!src/**/*.stories.ts",
        "!src/**/*.stories.tsx",
        "!src/**/*.unit.test.ts",
        "!src/**/*.visual-regression.test.ts",
        "!src/**/*.visual-regression.test.tsx",
        "!src/**/component.test.ts",
        "!src/**/component.test.tsx",
        "!src/**/end-to-end.test.ts",
        "!src/**/stories.ts",
        "!src/**/stories.tsx",
        "!src/**/unit.test.ts",
        "!src/**/visual-regression.test.ts",
        "!src/**/visual-regression.test.tsx",
        "!src/utils/decorator.tsx",
        "!src/utils/render.browser.tsx",
        "!src/utils/render.dom.tsx"
      ]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "env": ["CI", "VITEST_ARTIFACT_ROOT_DIR"],
      "inputs": [
        "config/vitest/vitest.config.ts",
        "src/**",
        "!src/**/snapshots",
        "!src/**/*.component.test.ts",
        "!src/**/*.component.test.tsx",
        "!src/**/*.end-to-end.test.ts",
        "!src/**/*.integration.test.ts",
        "!src/**/*.stories.ts",
        "!src/**/*.stories.tsx",
        "!src/**/*.visual-regression.test.ts",
        "!src/**/*.visual-regression.test.tsx",
        "!src/**/component.test.ts",
        "!src/**/component.test.tsx",
        "!src/**/end-to-end.test.ts",
        "!src/**/integration.test.ts",
        "!src/**/stories.ts",
        "!src/**/stories.tsx",
        "!src/**/visual-regression.test.ts",
        "!src/**/visual-regression.test.tsx",
        "!src/utils/decorator.tsx",
        "!src/utils/render.browser.tsx",
        "!src/utils/render.dom.tsx"
      ]
    },
    "test:visual-regression": {
      "dependsOn": ["^build"],
      "env": ["CI", "VITEST_ARTIFACT_ROOT_DIR"],
      "inputs": [
        "config/vitest/setup.visual-regression.ts",
        "config/vitest/vitest.config.ts",
        "src/**",
        "!src/**/*.component.test.ts",
        "!src/**/*.component.test.tsx",
        "!src/**/*.end-to-end.test.ts",
        "!src/**/*.integration.test.ts",
        "!src/**/*.stories.ts",
        "!src/**/*.stories.tsx",
        "!src/**/*.unit.test.ts",
        "!src/**/component.test.ts",
        "!src/**/component.test.tsx",
        "!src/**/end-to-end.test.ts",
        "!src/**/integration.test.ts",
        "!src/**/stories.ts",
        "!src/**/stories.tsx",
        "!src/**/unit.test.ts",
        "!src/utils/decorator.tsx",
        "!src/utils/render.dom.tsx"
      ]
    }
  }
}
