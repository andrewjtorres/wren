{
  "name": "@wren/console-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Control surface and runtime",
  "license": "MIT",
  "author": "Andrew J. Torres <andrew.jonathan.torres@gmail.com> (https://andrewjtorr.es)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewjtorres/wren.git",
    "directory": "packages/console-portal"
  },
  "type": "module",
  "imports": {
    "#.storybook/*": "./.storybook/*",
    "#src/*": "./src/*"
  },
  "scripts": {
    "build:portal": "react-router build",
    "build:studio": "storybook build --output-dir=dist/studio",
    "clean": "concurrently --group --raw \"yarn:clean:*\"",
    "clean:artifact": "del .react-router .turbo dist \"test-@(reports|results)\" \"*.log*\"",
    "clean:cache": "del node_modules/.cache",
    "dev": "cross-env NODE_ENV=\"${NODE_ENV:-development}\" tsx watch --inspect --tsconfig=config/typescript/tsconfig.vite.json server.ts",
    "format": "prettier --cache=node_modules/.cache/prettier/ --check --ignore-path=.prettierignore --log-level=warn \"**/*.@(json|md|webmanifest|yml)\"",
    "i18n:compile": "formatjs compile-folder --ast i18n src/i18n",
    "i18n:extract": "formatjs extract --id-interpolation-pattern=\"[sha512:contenthash:base64:10]\" --out-file=i18n/en.json --throws \"src/**/*.[jt]s?(x)\" \"!src/**/?(*.)@(end-to-end|integration|unit).test.[jt]s\" \"!src/**/?(*.)@(stories|@(component|visual-regression).test).[jt]s?(x)\"",
    "lint": "concurrently --group --raw \"yarn:lint:*\"",
    "lint:css": "stylelint --cache --cache-location=node_modules/.cache/stylelint/ \"**/*.css\"",
    "lint:i18n": "formatjs verify --source-locale=en --missing-keys --extra-keys --structural-equality \"i18n/**/*.json\"",
    "lint:javascript": "react-router typegen && eslint --cache --cache-location=node_modules/.cache/eslint/ \"**/*.[jt]s?(x)\"",
    "lint:typescript": "react-router typegen && tsc --build",
    "refine": "concurrently --group --raw \"yarn:format\" \"yarn:lint\"",
    "studio": "storybook dev --host=127.0.0.1 --no-open --port=6006",
    "test": "concurrently --group --raw \"yarn:test:*\"",
    "test:component": "cross-env VITEST_ARTIFACT_ROOT_DIR=test-reports/component vitest --config=config/vitest/vitest.config.ts --project=component",
    "test:end-to-end": "playwright test --config=config/playwright/playwright.config.ts",
    "test:integration": "cross-env VITEST_ARTIFACT_ROOT_DIR=test-reports/integration vitest --config=config/vitest/vitest.config.ts --pass-with-no-tests --project=integration",
    "test:unit": "cross-env VITEST_ARTIFACT_ROOT_DIR=test-reports/unit vitest --config=config/vitest/vitest.config.ts --project=unit",
    "test:visual-regression": "cross-env VITEST_ARTIFACT_ROOT_DIR=test-reports/visual-regression vitest --config=config/vitest/vitest.config.ts --project=visual-regression"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@react-router/fs-routes": "^8.4.0",
    "@react-router/node": "^8.4.0",
    "@tursodatabase/database": "0.7.2",
    "@tursodatabase/database-common": "0.7.2",
    "@wren/common": "workspace:^",
    "@wren/graph-manager": "workspace:^",
    "close-with-grace": "^2.5.0",
    "debug": "^4.4.3",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.8",
    "isbot": "^5.2.2",
    "nanoid": "^6.0.1",
    "pino": "^10.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-intl": "^10.2.2",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@formatjs/cli": "^6.16.30",
    "@formatjs/unplugin": "^1.2.11",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/debug": "^4.1.13",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^5.0.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "del-cli": "^7.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-formatjs": "^8.0.3",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.11.1",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^74.0.0",
    "happy-dom": "^20.14.5",
    "lint-staged": "^17.5.1",
    "make-dir-cli": "^4.0.0",
    "playwright": "^1.63.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.7",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rolldown": "^1.2.9",
    "storybook": "^10.6.0",
    "storybook-i18n": "^10.1.2",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-prettier": "^5.0.3",
    "supports-color": "^11.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "turbo": "^2.10.13",
    "type-fest": "^5.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "valibot": "^1.5.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vitest-browser-react": "^2.3.0"
  },
  "engines": {
    "node": ">=24.21",
    "yarn": ">=4.18"
  }
}
